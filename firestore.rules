rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------------------
    // I. Helper Functions
    // ----------------------------------------------------------------------------------
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdminOrSuperAdmin() {
      return isAuthenticated() && (
              request.auth.token.email == '4simpleproblems@gmail.com' ||
              (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin'])
      );
    }

    // ----------------------------------------------------------------------------------
    // II. User Profiles Collection (`users`)
    // ----------------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true; 
      allow list: if isAuthenticated(); 
      
      allow create: if isAdminOrSuperAdmin() || (
                      isOwner(userId)
                      && request.resource.id == request.auth.uid
                      && 'username' in request.resource.data
                      && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == request.auth.uid
                    );
      
      allow update: if isAdminOrSuperAdmin() || 
                    isOwner(userId) && (
                      !('username' in request.resource.data) || 
                      request.resource.data.username == resource.data.username ||
                      getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == request.auth.uid
                    ) || 
                    (isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'pending_requests', 'friends', 'navbarTheme', 'navbarPosition', 'username', 
                        'pfpType', 'customPfp', 'pfpLetterBg', 'letterAvatarColor', 'letterAvatarText',
                        'followerCount', 'followingCount', 'isOnline', 'currentActivity', 'lastActive',
                        'totalV6Time', 'leaderboardAccepted', 'leaderboardOptOut'
                     ])) ||
                    (!isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'navbarTheme', 'navbarPosition', 'username', 'dailySlotsUsed', 'lastPostReset', 
                        'blocked_users', 'friends', 'pending_requests', 'pfpType', 'customPfp', 
                        'pfpLetterBg', 'letterAvatarColor', 'letterAvatarText'
                     ]));

      allow delete: if isAdminOrSuperAdmin() || isOwner(userId);

      // Following / Followers subcollections
      match /following/{followedId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == followerId;
      }
    }

    // ----------------------------------------------------------------------------------
    // III. Username Reservations (`usernames`)
    // ----------------------------------------------------------------------------------
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid || isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // IV. Admin Status Collection (`admins`)
    // ----------------------------------------------------------------------------------
    match /admins/{userId} {
      allow read: if true;
      allow list: if isAdminOrSuperAdmin(); 
      allow create, update: if isAdminOrSuperAdmin(); 
      allow delete: if isAdminOrSuperAdmin() || isOwner(userId);
    }

    // ----------------------------------------------------------------------------------
    // V. Messenger Profiles (`messenger_profiles`)
    // ----------------------------------------------------------------------------------
    match /messenger_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // VI. Messages (`messages`)
    // ----------------------------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid) || isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // VII. Notifications (`notifications`)
    // ----------------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid || isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // VIII. Posts & Comments (`posts`, `comments`)
    // ----------------------------------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid || isAdminOrSuperAdmin();
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid || isAdminOrSuperAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid || isAdminOrSuperAdmin();
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid || isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // IX. Daily Photos Collection (`daily_photos` and `dailyPhotos`)
    // ----------------------------------------------------------------------------------
    match /daily_photos/{photoId} {
      allow read: if true; 
      allow create: if true;
      allow update: if (isAuthenticated() && (
        resource.data.creatorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts', 'comments'])
      )) || (!isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts', 'comments']));
      allow delete: if (isAuthenticated() && resource.data.creatorUid == request.auth.uid) || (!isAuthenticated()) || isAdminOrSuperAdmin();
    }

    match /dailyPhotos/{photoId} {
      allow create: if isAuthenticated() && (
        (request.resource.data.creatorUid == request.auth.uid) || 
        (request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAuthenticated() && (
        (resource.data.creatorUid == request.auth.uid) || 
        (resource.data.userId == request.auth.uid)
      ) || isAdminOrSuperAdmin();
      allow read: if true; 
    }

    // ----------------------------------------------------------------------------------
    // X. Friend Requests (`friend_codes` and `friendRequests`)
    // ----------------------------------------------------------------------------------
    match /friend_codes/{code} {
      allow read: if true;
      allow create: if true;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdminOrSuperAdmin();
      allow update: if false; 
    }

    match /friendRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        (resource.data.senderId == request.auth.uid) || 
        (resource.data.recipientId == request.auth.uid)
      ) || isAdminOrSuperAdmin();
      allow read: if isAuthenticated() && (
        (resource.data.senderId == request.auth.uid) || 
        (resource.data.recipientId == request.auth.uid)
      );
      allow update: if false;
    }
    
    // ----------------------------------------------------------------------------------
    // XI. Banned Users & Bans
    // ----------------------------------------------------------------------------------
    match /banned_users/{userId} {
      allow read, create, update, delete: if isAdminOrSuperAdmin();
    }
    
    match /bans/{userId} {
      allow read: if isAdminOrSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // XII. Global Configuration
    // ----------------------------------------------------------------------------------
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin() || 
                    (!isAuthenticated() && configId == 'soundboard' && 
                     request.resource.data.diff(resource.data).affectedKeys().hasAny(['explicitEnabled', 'thirdPartyEnabled']));
    }

    // ----------------------------------------------------------------------------------
    // XIII. Analytics Collection (`analytics` and `analytics_sessions`)
    // ----------------------------------------------------------------------------------
    match /analytics/{sessionId} {
      allow read: if isAdminOrSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdminOrSuperAdmin();

      allow create, update: if (request.auth == null && request.resource.data.userId == 'anonymous') ||
                               (isAuthenticated() && request.resource.data.userId == request.auth.uid);

      allow delete: if false;
    }

    match /analytics_sessions/{sessionId} {
      allow read, list: if isAdminOrSuperAdmin();
      allow create, update: if true; // Allow anyone to track sessions
      allow delete: if isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // XIV. Reports Collection (`reports`)
    // ----------------------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdminOrSuperAdmin();
    }
    
    // ----------------------------------------------------------------------------------
    // XV. Feedback Collection (`feedback`)
    // ----------------------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    // ----------------------------------------------------------------------------------
    // XVI. Leaderboard Collection (`leaderboard`)
    // ----------------------------------------------------------------------------------
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /access_codes/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (!isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']));
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid || isAdminOrSuperAdmin();
    }
  }
}
